{
  "name": "IT Asset Lakehouse",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "postCreateCommand": "pipx install uv && uv sync && uv run lakehouse run",
  "postAttachCommand": "uv run dagster dev -h 0.0.0.0 -p 3000",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Dagster", "onAutoForward": "openPreview" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["charliermarsh.ruff", "ms-python.python", "innoverio.vscode-dbt-power-user", "hashicorp.terraform"]
    }
  }
}
